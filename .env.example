# Offline mode needs no variables.
# Live mode (OpenAI-compatible Chat Completions + function calling)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Engine selection: auto | offline | live | opencode-local
# auto = live when OPENAI_API_KEY is set, otherwise offline.
AGENT_ENGINE=auto

# Optional: local OpenCode evidence adapter (experimental).
# The CLI path is machine-specific; do not commit credentials.
OPENCODE_CLI_PATH=
OPENCODE_PROVIDER=opencode-go
OPENCODE_MODEL=deepseek-v4.1-flash
